index 0000000000000000000000000000000000000000..d94118af6efc7537e9fccb173d8042d3d6c73c7b
--- /dev/null
+++ b/examples/compile_repository_policy.py
@@ -0,0 +1,31 @@
+"""Compile create/modify requirements; runtime enforcement is downstream."""
+
+import json
+
+from compiler import compile_action_policy
+
+
+def main():
+    policy = {
+        "schema_version": "action_policy.v1",
+        "contract_id": "repository-file-policy",
+        "contract_version": "2.0.0",
+        "action_requirements": {
+            "create": {
+                "required_role": None,
+                "allow": [{"match": "prefix", "value": "generated/"}],
+                "deny": [{"match": "prefix", "value": "generated/private/"}],
+            },
+            "modify": {
+                "required_role": "repository-maintainer",
+                "allow": [{"match": "exact", "value": "README.md"}],
+                "deny": [],
+            },
+        },
+    }
+    compiled = compile_action_policy(policy)
+    print(json.dumps(compiled, sort_keys=True, indent=2))
+
+
+if __name__ == "__main__":
+    main()
